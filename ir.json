{
  "name": "Iran Direct",
  "dns": {
    "servers": [
      {
        "tag": "app-dns-direct",
        "address": "5.200.200.200"
      }
    ]
  },
  "outbounds": [{}],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "ruleTag": "Direct Iran Domains",
        "domain": [
          "ext:IranGeoSite.dat:ALL",
          "ext:IranGeoSite.dat:IR"
        ],
        "outboundTag": "direct"
      },
      {
        "ruleTag": "Direct Iran IPs",
        "ip": [
          "geoip:PRIVATE",
          "geoip:IR"
        ],
        "outboundTag": "direct"
      }
    ]
  },
  "geodata": {
    "assets": [
      {
        "file": "IranGeoSite.dat",
        "url": "https://github.com/bootmortis/iran-hosted-domains/releases/latest/download/iran.dat"
      }
    ]
  }
}
